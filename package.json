{
  "name": "mcp-tool-card-fleet-summary",
  "version": "0.1.0",
  "description": "Fleet-analyze a directory of MCP Tool Card documents. Counts by side-effect class and pii_exposure, surfaces governance gaps: destructive tools missing human-approval / audit log / IRU, high-PII tools without rate limiting, secret-writing tools without audit. Makes the fleet-summary tool family a quartet alongside agent-card / prompt-provenance / evidence-bundle.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/mcp-tool-card-fleet-summary"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tool-card",
    "fleet",
    "governance",
    "audit",
    "ai-governance",
    "kinetic-gain-suite",
    "typescript"
  ],
  "bin": {
    "mcp-tool-card-fleet-summary": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts fixtures/cards --format markdown",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  }
}
